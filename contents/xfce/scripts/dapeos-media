#!/usr/bin/env python3
# DapeOS removable media tray - cesky, ikona jen kdyz je medium pripojene.
import json
import os
import time
import subprocess
import sys

from PyQt5.QtCore import QTimer
from PyQt5.QtGui import QIcon
from PyQt5.QtWidgets import QAction, QApplication, QMenu, QSystemTrayIcon

ICON = "drive-removable-media"
LOG = "/tmp/dapeos-media.log"


def log(msg):
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except OSError:
        pass


def lsblk():
    try:
        out = subprocess.run(
            ["lsblk", "-J", "-o", "NAME,RM,TYPE,LABEL,MOUNTPOINT,SIZE"],
            capture_output=True, text=True, timeout=4,
            env=dict(os.environ, LANG="C", LC_ALL="C"),
        ).stdout
        return json.loads(out).get("blockdevices", [])
    except Exception:
        return []


def sys_removable(name):
    try:
        with open(f"/sys/block/{name}/removable", encoding="utf-8") as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def devices():
    result = []
    for disk in lsblk():
        removable = disk.get("rm") in (True, "1", 1) or sys_removable(disk["name"])
        if not removable:
            continue
        for part in disk.get("children", []):
            if part.get("type") != "part":
                continue
            result.append({
                "dev": "/dev/" + part["name"],
                "parent": "/dev/" + disk["name"],
                "label": part.get("label") or part["name"],
                "mount": part.get("mountpoint"),
            })
    return result


class MediaTray(QSystemTrayIcon):
    def __init__(self):
        super().__init__(QIcon.fromTheme(ICON))
        self.setToolTip("Vyměnitelná média")
        self.menu = QMenu()
        self.setContextMenu(self.menu)
        self.seen = set()
        self.pending = {}
        self.opened = set()
        self.first_scan = True
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.scan)
        self.timer.start(1200)
        self.scan()

    def run(self, args):
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def open_thunar(self, path):
        try:
            out = subprocess.run(["wmctrl", "-l"], capture_output=True,
                                 text=True, timeout=3).stdout
        except Exception:
            out = ""
        name = os.path.basename(path)
        if name and name in out:
            return
        subprocess.Popen(["thunar", path], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)

    def action_mount(self, dev):
        self.run(["udisksctl", "mount", "-b", dev])

    def action_eject(self, dev, parent):
        self.run(["sh", "-c",
                  f"udisksctl unmount -b {dev} >/dev/null 2>&1; "
                  f"udisksctl power-off -b {parent} >/dev/null 2>&1"])

    def scan(self):
        devs = devices()
        for d in devs:
            if not d["mount"]:
                if d["dev"] not in self.pending:
                    self.pending[d["dev"]] = time.time()
                elif time.time() - self.pending[d["dev"]] > 2:
                    log(f"fallback mount {d['dev']}")
                    subprocess.Popen(["udisksctl", "mount", "-b", d["dev"]],
                                     stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
                    self.pending.pop(d["dev"], None)
            else:
                self.pending.pop(d["dev"], None)
                if d["dev"] not in self.opened:
                    self.opened.add(d["dev"])
                    if not self.first_scan:
                        QTimer.singleShot(
                            1000, lambda m=d["mount"]: self.open_thunar(m))
            self.seen.add(d["dev"])
        present = {d["dev"] for d in devs}
        self.opened &= present
        self.pending = {k: v for k, v in self.pending.items() if k in present}
        log("devices: " + ", ".join(f"{d['dev']} mount={d['mount']}" for d in devs))
        self.first_scan = False
        self.menu.clear()
        if not devs:
            self.hide()
            return

        title = QAction("Vyměnitelná média", self)
        title.setEnabled(False)
        self.menu.addAction(title)
        self.menu.addSeparator()

        for d in devs:
            if d["mount"]:
                act = QAction(f"Vysunout {d['label']}", self)
                act.triggered.connect(
                    lambda _=False, x=d["dev"], p=d["parent"]: self.action_eject(x, p))
            else:
                act = QAction(f"Připojit {d['label']}", self)
                act.triggered.connect(
                    lambda _=False, x=d["dev"]: self.action_mount(x))
            self.menu.addAction(act)

        self.menu.addSeparator()
        quit_act = QAction("Ukončit", self)
        quit_act.triggered.connect(QApplication.instance().quit)
        self.menu.addAction(quit_act)

        self.setIcon(QIcon.fromTheme(ICON))
        self.show()


if __name__ == "__main__":
    app = QApplication(sys.argv)
    QIcon.setThemeName("Papirus")
    tray = MediaTray()
    sys.exit(app.exec_())
